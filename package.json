{
  "name": "coastline-drive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:physics": "esbuild scripts/smoke-physics.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.smoke.mjs && node scripts/.smoke.mjs",
    "test:ui": "esbuild scripts/smoke-ui.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.smoke-ui.mjs && node scripts/.smoke-ui.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.27.1",
    "@babylonjs/havok": "^1.3.10",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
